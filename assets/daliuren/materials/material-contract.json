      "allowedSurfaces": ["grooves", "underside seams", "bearing roots"],
      "effect": "increase patina coverage and roughness"
    },
    "mask_insert_dirt": {
      "attribute": "causal_insert_boundary",
      "attributeDomain": "FACE",
      "cleanValue": 0.0,
      "phaseAttribute": "dirt_phase",
