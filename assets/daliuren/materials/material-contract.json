  "masks": {
    "mask_contact_wear": {
      "attribute": "causal_contact_wear",
      "attributeDomain": "FACE",
      "cleanValue": 0.0,
      "cause": "repeated touch or sliding contact",
      "allowedSurfaces": ["outer touch edges", "detents", "rails", "insert slots"],
      "effect": "reduce bronze roughness"
    },
    "mask_recess_oxidation": {
      "attribute": "causal_recess_oxidation",
      "attributeDomain": "FACE",
      "cleanValue": 0.0,
      "cause": "moisture and dirt retention in sheltered recesses",
      "allowedSurfaces": ["grooves", "underside seams", "bearing roots"],
      "effect": "increase patina coverage and roughness"
    },
    "mask_insert_dirt": {
      "attribute": "causal_insert_boundary",
      "attributeDomain": "FACE",
      "cleanValue": 0.0,
      "phaseAttribute": "dirt_phase",
      "cause": "debris trapped at material boundaries",
      "allowedSurfaces": ["bronze/celadon boundaries"],
      "effect": "localized asymmetric boundary tint"
    },
    "mask_celadon_crackle": {
      "attribute": "causal_celadon_crackle",
      "cause": "glaze shrinkage",
      "allowedSurfaces": ["celadon objects and islands"],
      "effect": "restrained Voronoi distance-to-edge crackle"
    }
  },
  "assignmentRules": {
