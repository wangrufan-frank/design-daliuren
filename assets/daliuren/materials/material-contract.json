    },
    "mask_celadon_crackle": {
      "attribute": "causal_celadon_crackle",
      "cause": "glaze shrinkage",
      "allowedSurfaces": ["celadon objects and islands"],
      "effect": "restrained Voronoi distance-to-edge crackle"
    }
  },
  "assignmentRules": {
    "bronze": "load-bearing structure, joints, rails, locks and mechanisms",
